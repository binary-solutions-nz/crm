# ---------------------------------------------------------------------------
# Cloud Functions params (non-secret). Copy to `.env` for local emulator use,
# or to `.env.<your-project-id>` for a specific project. In CI these are
# generated from GitHub secrets by the deploy workflow.
#
# The CLIENT SECRET is NOT stored here — it is a Cloud Secret Manager secret.
# Set it once with:  firebase functions:secrets:set GRAPH_CLIENT_SECRET
# ---------------------------------------------------------------------------

# Entra ID (Azure AD) app registration used to send mail via Microsoft Graph.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Mailbox the reminder is sent FROM (must be a real licensed mailbox).
MAIL_SENDER=info@binarysolutions.co.nz

# Comma-separated recipients of the digest.
MAIL_RECIPIENTS=info@binarysolutions.co.nz,info@binary.kiwi

# Include renewals due within this many days.
REMINDER_WINDOW_DAYS=30

# Include device warranty expiries in the digest (true/false).
INCLUDE_WARRANTIES=true
