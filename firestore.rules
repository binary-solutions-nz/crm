rules_version = '2';

// Binary Solutions CRM — internal IT Support tool.
//
// Access model: accounts are provisioned MANUALLY in the Firebase console
// (Authentication > Users). There is no public sign-up. Therefore any
// authenticated user is a trusted staff member and may read/write CRM data.
//
// If you later want per-user roles (e.g. read-only staff), add a
// `staff/{uid}` document with a `role` field and check it here.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // All CRM collections: clients, contacts, devices, services, subscriptions.
    match /clients/{docId} {
      allow read, write: if isSignedIn();
    }
    match /contacts/{docId} {
      allow read, write: if isSignedIn();
    }
    match /devices/{docId} {
      allow read, write: if isSignedIn();
    }
    match /services/{docId} {
      allow read, write: if isSignedIn();
    }
    match /subscriptions/{docId} {
      allow read, write: if isSignedIn();
    }

    // Reminder run log written by the scheduled Cloud Function (via Admin SDK,
    // which bypasses these rules). Staff may read it; no client writes.
    match /reminderRuns/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
