# ---------------------------------------------------------------------------
# Firebase Web SDK config (frontend). Copy this file to `.env` and fill in the
# values from: Firebase console > Project settings > General > Your apps > SDK
# setup and configuration.
#
# These values are NOT secret — they are shipped to the browser. Access is
# controlled by Firebase Authentication + Firestore security rules.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=binary-solutions-crm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=binary-solutions-crm
VITE_FIREBASE_STORAGE_BUCKET=binary-solutions-crm.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
